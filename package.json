{
  "name": "family-weekend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/index.ts",
    "start": "node server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run check:ecosystem",
    "check:ecosystem": "spectre-manifest-validate spectre.manifest.json && spectre-manifest-check spectre.manifest.json .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@phcdevworks/spectre-components": "^1.25.0",
    "@phcdevworks/spectre-shell": "^1.8.0",
    "@phcdevworks/spectre-shell-router": "^1.6.0",
    "@phcdevworks/spectre-shell-signals": "^1.6.1",
    "@phcdevworks/spectre-tokens": "^4.15.0",
    "@phcdevworks/spectre-ui": "^5.8.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@phcdevworks/spectre-manifest": "^2.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "version": "1.0.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "description": "Plan a family weekend in any city: weather, kid-friendly activities, and an Italian restaurant from live sources."
}
